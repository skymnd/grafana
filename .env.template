GF_PLUGINS_PREINSTALL=grafana-clock-panel
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=authentik
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://authentik.domain.tld/application/o/authorize/
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://authentik.domain.tld/application/o/token/
GF_AUTH_GENERIC_OAUTH_API_URL=https://authentik.domain.tld/application/o/userinfo/
GF_AUTH_SIGNOUT_REDIRECT_URL=https://authentik.domain.tld/application/o/grafana/end-session/
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'ServiceAdmins') && 'Admin' || 'Viewer'
# Required if Grafana is running behind a reverse proxy
GF_SERVER_ROOT_URL=https://grafana.domain.tld
HOMELAB_DOMAIN=domain.tld
